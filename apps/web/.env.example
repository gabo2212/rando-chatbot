BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Local Postgres + pgvector (Docker Compose)
DATABASE_URL=postgresql://rando:rando@127.0.0.1:5433/rando

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# xAI / Grok — Discord @mention + /chat replies, and Endless Drive "RANDO Council" NPC lines.
# Discord AI requires XAI_API_KEY. Council falls back to a local generator if unset.
XAI_API_KEY=
# Non-reasoning model = no wasted reasoning tokens for chatty nonsense.
# grok-4.20-non-reasoning supports text + image (Discord @mention vision).
XAI_MODEL=grok-4.20-non-reasoning
# Optional: override model only when Discord mentions include images/GIFs.
# XAI_VISION_MODEL=grok-4.20-non-reasoning
# Optional: override the council persona. Falls back to a built-in default.
COUNCIL_SYSTEM_PROMPT=

# Local Ollama embeddings (Docker Compose)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Discord integration (official bot + OAuth — never commit real secrets)
# Redirect URI must match the Discord Developer Portal exactly:
#   http://localhost:3001/api/integrations/discord/callback
#   https://<your-production-domain>/api/integrations/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3001/api/integrations/discord/callback
DISCORD_PUBLIC_KEY=
# Any passphrase or 32-byte hex/base64 — used to encrypt OAuth tokens at rest
DISCORD_ENCRYPTION_KEY=
# Shared secret between the web app and the optional discord-worker process
DISCORD_WORKER_SECRET=

# On the discord-worker host only (not required on Vercel):
# WEB_APP_URL=https://chatbot-ecru-two-16.vercel.app
